# CORS -- comma-separated origins allowed to call this API. Add your deployed
# frontend's URL here in production (e.g. https://your-app.vercel.app).
ALLOWED_ORIGINS=http://localhost:3000

# Alpaca (paper trading only)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Must be "true" for the app to ever submit orders. If not exactly "true",
# every execution path refuses to trade (fail closed). Never set to false.
ALPACA_PAPER_TRADE=true

# LLM provider -- set ONE of these. First configured key wins, in this order:
# Anthropic > Featherless > OpenAI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Featherless (api.featherless.ai) -- OpenAI-compatible gateway to open models.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=volmind

# Risk controls
VOLMIND_MAX_POSITION_RISK=500
VOLMIND_MAX_DAILY_LOSS=1500
VOLMIND_MIN_DIVERGENCE=0.1
VOLMIND_MIN_CONFIDENCE=0.55
VOLMIND_MAX_OPEN_TRADES=3

# Position management (exit rules used by app.services.position_monitor)
VOLMIND_TAKE_PROFIT_PCT=0.50
VOLMIND_STOP_LOSS_PCT=0.50
VOLMIND_MIN_DAYS_TO_EXPIRY_EXIT=1

# Autonomous operation -- off by default (fail closed, like everything else here).
# Set to "true" to have the API process scan + monitor positions on its own schedule,
# or run `python scripts/run_autonomous.py` as a standalone process instead.
VOLMIND_AUTONOMOUS_MODE=false
VOLMIND_WATCHLIST=AAPL,MSFT,NVDA,SPY
VOLMIND_SCAN_INTERVAL_MINUTES=30
VOLMIND_MONITOR_INTERVAL_MINUTES=5
